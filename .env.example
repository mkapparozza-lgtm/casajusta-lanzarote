# Copia este archivo a .env.local y rellena lo que necesites.

# --- Base de datos ---
# Neon: cadena de conexión "pooled" (Project → Connection Details).
# Si la dejas vacía en local, se usa PGlite (Postgres en WASM) en ./.pglite
DATABASE_URL=

# --- Datos de ejemplo ---
# true SOLO en local/preview para ver los datos del script de seed. En producción: vacío o false.
SHOW_SEED_DATA=false
# Permite `npm run db:seed` contra una base remota (p. ej. una rama de desarrollo de Neon). Nunca en producción.
SEED_ALLOW_REMOTE=false

# --- Anti-manipulación ---
# Secreto para el hash HMAC del dispositivo (genera uno largo y aleatorio).
DEVICE_HASH_SECRET=
# Horas entre dos casos del mismo dispositivo (0 = sin límite, útil en local).
RATE_LIMIT_HOURS=24
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). Obligatorio en producción.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Panel de administración (/es/admin) ---
ADMIN_PASSWORD=
# Secreto para firmar la sesión del admin (largo y aleatorio).
ADMIN_SESSION_SECRET=

# --- Aportaciones ---
# Sección "Haz oír nuestra voz" (objetivos y cuentas). Apagada por ahora: el sitio no pide dinero.
SHOW_SUPPORT_SECTION=false
# Stripe Checkout (requiere además SHOW_SUPPORT_SECTION=true).
# Desactivado hasta que haya una cuenta para recibir aportaciones. Mientras sea false, el botón dice "Próximamente".
DONATIONS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL pública del sitio, para las páginas de vuelta de Stripe.
SITE_URL=https://casajustalanzarote.com
